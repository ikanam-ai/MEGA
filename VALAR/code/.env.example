# Copy this file to .env and fill local values.
# Do not commit .env.

# ClearML (optional, for experiment tracking)
CLEARML_HOST_IP=
CLEARML_WEB_HOST=
CLEARML_API_HOST=
CLEARML_FILES_HOST=
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=

# ValueLlama endpoint (vLLM OpenAI-compatible)
VALAR_VALUELLAMA_API_BASE_URL=http://127.0.0.1:8000/v1
VALAR_VALUELLAMA_API_KEY=EMPTY
VALAR_SERVED_MODEL_NAME=ValueLlama-3-8B

# Raw dataset paths (populated by scripts/data/pull_raw_datasets.py)
VALAR_DATASETS_ROOT=../../datasets

# Output root for annotation runs
VALAR_RESULTS_ROOT=results
